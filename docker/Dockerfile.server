# docker/Dockerfile.server
# Production image for Express API (ECS)
# Fix: pnpm install -r installs ALL workspace package dependencies

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl postgresql-client
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

# ---- Builder: install everything and build ----
FROM base AS builder
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/workers/package.json apps/workers/package.json
COPY packages/ ./packages/

# Install dependencies for all workspace packages
RUN pnpm install --frozen-lockfile

# Generate Prisma client
RUN pnpm --filter=@repo/db exec prisma generate --schema=./prisma/schema.prisma

# Copy full source and build only the server
COPY . .
RUN pnpm turbo run build --filter=server

# ---- Runner: minimal production image ----
FROM node:20-alpine AS runner
RUN apk add --no-cache openssl postgresql-client
RUN addgroup --system --gid 1001 appuser
RUN adduser --system --uid 1001 appuser
WORKDIR /app

# Copy entire node_modules with all symlinks intact from builder
COPY --from=builder --chown=appuser:appuser /app/node_modules ./node_modules

# Copy built server
COPY --from=builder --chown=appuser:appuser /app/apps/server/dist ./apps/server/dist

# Copy prisma package (needed for generated client and runtime)
COPY --from=builder --chown=appuser:appuser /app/packages/database ./packages/database

USER appuser
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/health || exit 1

CMD ["node", "/app/apps/server/dist/index.js"]
