# docker/Dockerfile.web
# Production image for Next.js web app (ECS)
# Fix: using standalone mode which includes all needed dependencies

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

# ---- Builder: install everything and build ----
FROM base AS builder
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/workers/package.json apps/workers/package.json
COPY packages/ ./packages/

# Install dependencies for all workspace packages
RUN pnpm install --frozen-lockfile

# Generate Prisma client
RUN pnpm --filter=@repo/db exec prisma generate --schema=./prisma/schema.prisma

# Copy full source and build only the web app
COPY . .
RUN pnpm turbo run build --filter=web

# ---- Runner: minimal production image ----
FROM node:20-alpine AS runner
RUN apk add --no-cache openssl
RUN addgroup --system --gid 1001 appuser
RUN adduser --system --uid 1001 appuser
WORKDIR /app

# Next.js standalone mode includes runtime, copy the standalone output
COPY --from=builder --chown=appuser:appuser /app/apps/web/.next/standalone ./
COPY --from=builder --chown=appuser:appuser /app/apps/web/.next/static ./.next/static
COPY --from=builder --chown=appuser:appuser /app/apps/web/public ./public

USER appuser
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

CMD ["node", "server.js"]
