# docker/Dockerfile.web
# Production image for Next.js web app (ECS)
# No migrations, no server/worker artifacts

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

# ---- Builder: copy everything, install, and build ----
FROM base AS builder
# Copy workspace and lock file
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./

# Copy ALL package.json and source files
COPY packages/ ./packages/
COPY apps/web ./apps/web/

# Install all dependencies in one go (pnpm resolves entire monorepo)
RUN pnpm install --frozen-lockfile

# Generate Prisma client
RUN pnpm --filter=@repo/db exec prisma generate --schema=./prisma/schema.prisma

# Build only the web app
RUN pnpm turbo run build --filter=web

# ---- Runner: minimal production image ----
FROM node:20-alpine AS runner
RUN apk add --no-cache openssl
RUN addgroup --system --gid 1001 appuser
RUN adduser --system --uid 1001 appuser
WORKDIR /app

# Next.js standalone mode includes runtime, so copy the standalone output
COPY --from=builder --chown=appuser:appuser /app/apps/web/.next/standalone ./
COPY --from=builder --chown=appuser:appuser /app/apps/web/.next/static ./.next/static
COPY --from=builder --chown=appuser:appuser /app/apps/web/public ./public

USER appuser
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

CMD ["node", "server.js"]
