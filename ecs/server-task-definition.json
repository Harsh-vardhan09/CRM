{
  "family": "crm-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "crm-server",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/crm-server:latest",
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:5000/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/crm-server",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "server"
        }
      },
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "5000"
        },
        {
          "name": "CLIENT_URL",
          "value": "https://app.example.com"
        },
        {
          "name": "JWT_ALGORITHM",
          "value": "HS256"
        },
        {
          "name": "JWT_ACCESS_EXPIRATION",
          "value": "15m"
        },
        {
          "name": "JWT_REFRESH_EXPIRATION",
          "value": "7d"
        },
        {
          "name": "LEAD_FROM_EMAIL",
          "value": "noreply@example.com"
        },
        {
          "name": "TWILIO_FROM_NUMBER",
          "value": "+1234567890"
        },
        {
          "name": "TWILIO_PHONE_NUMBER",
          "value": "+1234567890"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://<ELASTICACHE_ENDPOINT>:6379"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "<RDS_ENDPOINT>"
        },
        {
          "name": "POSTGRES_PORT",
          "value": "5432"
        },
        {
          "name": "POSTGRES_USER",
          "value": "postgres"
        },
        {
          "name": "POSTGRES_DB",
          "value": "crm"
        }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/JWT_SECRET"
        },
        {
          "name": "JWT_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/JWT_PRIVATE_KEY"
        },
        {
          "name": "JWT_PUBLIC_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/JWT_PUBLIC_KEY"
        },
        {
          "name": "TWILIO_ACCOUNT_SID",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/TWILIO_ACCOUNT_SID"
        },
        {
          "name": "TWILIO_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/TWILIO_AUTH_TOKEN"
        },
        {
          "name": "RESEND_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/RESEND_API_KEY"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/DATABASE_URL"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/server/POSTGRES_PASSWORD"
        }
      ]
    }
  ],
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskRole",
  "tags": [
    {
      "key": "Service",
      "value": "crm-server"
    },
    {
      "key": "Environment",
      "value": "production"
    }
  ]
}
