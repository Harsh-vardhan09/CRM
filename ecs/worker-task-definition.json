{
  "family": "crm-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "crm-worker",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/crm-worker:latest",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/crm-worker",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "worker"
        }
      },
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "LEAD_FROM_EMAIL",
          "value": "noreply@example.com"
        },
        {
          "name": "TWILIO_FROM_NUMBER",
          "value": "+1234567890"
        },
        {
          "name": "TWILIO_PHONE_NUMBER",
          "value": "+1234567890"
        },
        {
          "name": "LEAD_INACTIVITY_DAYS",
          "value": "14"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://<ELASTICACHE_ENDPOINT>:6379"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "<RDS_ENDPOINT>"
        },
        {
          "name": "POSTGRES_PORT",
          "value": "5432"
        },
        {
          "name": "POSTGRES_USER",
          "value": "postgres"
        },
        {
          "name": "POSTGRES_DB",
          "value": "crm"
        }
      ],
      "secrets": [
        {
          "name": "TWILIO_ACCOUNT_SID",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/worker/TWILIO_ACCOUNT_SID"
        },
        {
          "name": "TWILIO_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/worker/TWILIO_AUTH_TOKEN"
        },
        {
          "name": "RESEND_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/worker/RESEND_API_KEY"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/worker/DATABASE_URL"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/worker/POSTGRES_PASSWORD"
        }
      ]
    }
  ],
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskRole",
  "tags": [
    {
      "key": "Service",
      "value": "crm-worker"
    },
    {
      "key": "Environment",
      "value": "production"
    }
  ]
}
